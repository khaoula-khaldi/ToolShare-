const Materiel = require("../models/Materiel");

const creer = async (data) => {
    return await Materiel.create(data);
};

const trouverTous = async (filtres = {}) => {
    return await Materiel.find(filtres);
};

const trouverParId = async (id) => {
    return await Materiel.findById(id);
};

const modifierParId = async (id, data) => {
    return await Materiel.findByIdAndUpdate(id, data, {
        returnDocument: 'after',
        runValidators: true
    });
};

const verrouiller = async (id, dureeMs = 10000) => {
    const maintenant = new Date();
    const verrou = new Date(maintenant.getTime() + dureeMs);

    const materiel = await Materiel.findOneAndUpdate(
        {
            _id: id,
            $or: [{ verrouReservation: null }, { verrouReservation: { $lte: maintenant } }]
        },
        { verrouReservation: verrou },
        { returnDocument: 'after' }
    );

    return materiel ? verrou : null;
};

const deverrouiller = async (id, verrou) => {
    return await Materiel.updateOne({ _id: id, verrouReservation: verrou }, { verrouReservation: null });
};

module.exports = {
    creer,
    trouverTous,
    trouverParId,
    modifierParId,
    verrouiller,
    deverrouiller
};