const Reservation = require("../models/Reservation");

const MATERIEL_FIELDS = "nom description etat";
const MAGASIN_FIELDS = "nom adresse";

const trouverChevauchements = async (materielId, debut, fin, maintenant = new Date()) => {
    return await Reservation.find({
        materielId,
        dateDebut: { $lt: fin },
        $or: [
            { statut: "CONFIRMEE", dateFin: { $gt: debut } },
            { statut: "EN_COURS", $or: [{ dateFin: { $gt: debut } }, { dateFin: { $lte: maintenant } }] }
        ]
    })
        .select("dateDebut dateFin statut")
        .sort({ dateDebut: 1 });
};

const creer = async (data) => {
    return await Reservation.create(data);
};

const trouverParUtilisateur = async (filtre, { skip = 0, limit = 20 } = {}) => {
    return await Reservation.find(filtre)
        .populate("materielId", MATERIEL_FIELDS)
        .populate("magasinId", MAGASIN_FIELDS)
        .sort({ dateDebut: -1 })
        .skip(skip)
        .limit(limit);
};

const compter = async (filtre) => {
    return await Reservation.countDocuments(filtre);
};

const trouverParIdEtUtilisateur = async (id, utilisateurId) => {
    return await Reservation.findOne({ _id: id, utilisateurId })
        .populate("materielId", MATERIEL_FIELDS)
        .populate("magasinId", MAGASIN_FIELDS);
};

module.exports = {
    trouverChevauchements,
    creer,
    trouverParUtilisateur,
    compter,
    trouverParIdEtUtilisateur
};